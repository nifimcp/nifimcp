{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nifimcp/nifimcp",
  "title": "NiFiMCP",
  "description": "Evidence-backed, read-only Apache NiFi investigation: cited evidence and reviewable flow drafts",
  "version": "0.1.0-rc.1",
  "websiteUrl": "https://nifimcp.com",
  "repository": {
    "url": "https://github.com/nifimcp/nifimcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "nifimcp-server",
      "version": "0.1.0rc1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--config",
          "description": "Path to a NiFiMCP operator configuration file (demo, bundle or live mode)",
          "format": "filepath",
          "isRequired": true
        }
      ]
    }
  ]
}
